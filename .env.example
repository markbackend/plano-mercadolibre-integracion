# Copiar a .env y completar. NUNCA subir el .env al repositorio.

# --- Aplicación de Mercado Libre (portal de desarrolladores) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Tiene que coincidir EXACTO con la "URI de redirect" cargada en la aplicación (en producción, https).
ML_REDIRECT_URI=http://localhost:8000/auth/callback
# Sitio: MLA (Argentina), MLB, MLM, MLC, MCO, MLU, MPE
ML_SITIO=MLA
ML_API_URL=https://api.mercadolibre.com
# Vacío = se deduce del sitio (auth.mercadolibre.com.ar para MLA). Para el simulador: http://127.0.0.1:8001
ML_AUTH_URL=
# Renovar el access_token esta cantidad de segundos antes de que venza
ML_MARGEN_RENOVACION_SEG=600
# Reintentos ante 429 / 5xx / error de red (espera exponencial o Retry-After)
ML_MAX_REINTENTOS=5
ML_ESPERA_BASE_SEG=1.0

# --- Archivos ---
DB_PATH=datos/mercadolibre.db
REGLAS_PREGUNTAS_PATH=config/reglas_preguntas.json
SALIDAS_DIR=salidas

# --- Fuente de stock/precio del cliente ---
# csv | excel | api
FUENTE_TIPO=csv
FUENTE_RUTA=ejemplos/stock_cliente.csv
# Si FUENTE_TIPO=api: GET que devuelve [{"sku": "...", "stock": 3, "precio": 1234.5}, ...]
FUENTE_API_URL=
FUENTE_API_TOKEN=
# true = solo muestra qué cambiaría (recomendado hasta revisar con el cliente)
SYNC_SIMULACRO=true
SYNC_ACTUALIZAR_PRECIO=true
SYNC_ACTUALIZAR_STOCK=true

# --- Preguntas ---
# sugerir (una persona aprueba) | automatico | apagado
PREGUNTAS_MODO=sugerir
IA_ACTIVADA=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-haiku-5-5
ANTHROPIC_URL=https://api.anthropic.com/v1/messages

# --- Avisos de ventas al dueño (cualquiera, ambos o ninguno) ---
AVISO_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Seguridad de los endpoints /admin (encabezado X-Admin-Token). Obligatorio en producción. ---
ADMIN_TOKEN=
